# Variables de entorno — copiar a `.env` y rellenar (NO commitear el .env)

# --- PocketBase (backend) ---
PB_URL=https://backtendcenso.andresdig.org
PB_EMAIL=admin@mep.com
PB_PASSWORD=cambiar

# --- Usuario admin de la app (rol admin, único) ---
APP_ADMIN_EMAIL=admin@mep.org.ve
APP_ADMIN_PASSWORD=cambiar

# --- Frontend (se inyecta en build de Vite) ---
VITE_PB_URL=https://backtendcenso.andresdig.org
VITE_APP_NAME=Militante MEP
VITE_WORKER_URL=
VITE_WORKER_API_KEY=

# --- Worker (generación de carnet + cron) ---
WORKER_PORT=8787
WORKER_API_KEY=
