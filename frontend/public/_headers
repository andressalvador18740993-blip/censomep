# Cabeceras de seguridad globales
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'

# El service worker y el HTML nunca deben quedar cacheados por el navegador/CDN,
# para que los dispositivos con la PWA instalada reciban la versión nueva.
/sw.js
  Cache-Control: no-cache

/registerSW.js
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# Los assets con hash sí pueden cachearse "para siempre".
/assets/*
  Cache-Control: public, max-age=31536000, immutable
